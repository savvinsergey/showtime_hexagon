{
  "name": "@showtime/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx serve",
    "start:shell": "sudo nx serve shell",
    "commit": "cz",
    "lint": "nx run-many --target=lint --all --skip-nx-cache --fix --uncommitted",
    "stylelint": "nx run-many --target=stylelint --all --skip-nx-cache --fix --uncommitted --verbose",
    "format": "nx format:write --libs-and-apps --skip-nx-cache --uncommitted",
    "build": "nx run-many --target=build --all --parallel",
    "bundle:analyze": "source-map-explorer dist/**/*.js",
    "bundle:build": "nx run-many --target=build --all --prod --source-map",
    "docs:build": "compodoc -p tsconfig.doc.json -d dist/docs",
    "docs:serve": "compodoc -s -p tsconfig.doc.json -d dist/docs",
    "release": "npx nx run-many --target=version",
    "prepare": "husky"
  },
  "imports": {
    "#styles": "./libs/shared/styles/src/global.scss"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~22.1.0",
    "@angular/cdk": "22.0.0",
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "@angular/router": "~22.1.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@ng-icons/simple-icons": "^36.0.0",
    "@softarc/native-federation-node": "^3.3.4",
    "@spartan-ng/brain": "1.4.1",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "es-module-shims": "^1.5.12",
    "ngx-scrollbar": "^19.1.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.1.3",
    "@angular-devkit/build-angular": "~22.1.0",
    "@angular-devkit/core": "~22.1.0",
    "@angular-devkit/schematics": "~22.1.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.0",
    "@angular/compiler-cli": "~22.1.0",
    "@angular/language-service": "~22.1.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@compodoc/compodoc": "github:compodoc/compodoc",
    "@eslint/js": "^9.8.0",
    "@jscutlery/semver": "^7.1.0",
    "@ngrx/eslint-plugin": "^22.0.1",
    "@nx/angular": "23.2.1",
    "@nx/cypress": "23.2.1",
    "@nx/eslint": "^23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@schematics/angular": "~22.1.0",
    "@spartan-ng/cli": "^1.4.1",
